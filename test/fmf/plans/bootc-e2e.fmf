summary: FDO bootc test plan
description: FDO device onboarding in bootc image

tag:
  - server

discover:
    how: fmf
    filter: tag:bootc & tag:server

provision:
    hardware:
        virtualization:
            is-supported: true
        cpu:
            processors: ">= 2"
        memory: ">= 6 GB"

prepare:
  # Enable COPR before test `require:` (default order 50) so skip_build
  # jobs can install go-fdo-server* from the guest's fedora-iot chroot.
  # Skip when Packit already installed PR artifacts.
  - name: enable-fedora-iot-copr
    how: shell
    order: 10
    script: |
      set -xeo pipefail
      if [ -n "${PACKIT_COPR_RPMS:-}" ]; then
        exit 0
      fi
      rpm -q --whatprovides 'dnf-command(copr)' &> /dev/null || dnf install -y 'dnf-command(copr)'
      dnf copr list | grep 'fedora-iot/fedora-iot' || {
        . /etc/os-release
        if [ "${ID}" = "centos" ]; then
          dnf copr enable -y '@fedora-iot/fedora-iot' ${ID}-stream-${VERSION_ID:-${ID_VERSION}}
        else
          dnf copr enable -y '@fedora-iot/fedora-iot'
        fi
      }

  - how: shell
    script: |
      . /etc/os-release
      if [ "${ID}" = "centos" ]; then
        dnf install -y epel-release
      fi

  - how: install
    package:
      - golang
      - make
      - openssl
      - curl
      - git
      - jq
      - npm
      - podman
      - qemu-img
      - qemu-kvm
      - libvirt-client
      - libvirt-daemon-kvm
      - virt-install
      - firewalld
      - lorax
      - gobject-introspection

execute:
    how: tmt
